<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.unilearn"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- Runs on TVs and on phones/tablets. leanback is not *required* so the
         same APK also installs on a handset, where it still works. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- The whole app is bundled in assets and works offline. INTERNET is
         declared only because some WebView text-to-speech engines want it for
         narration; nothing is ever fetched. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- shows in the Android TV launcher -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- and in a phone/tablet launcher -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
</manifest>
